{
    "name": "anticrybot",
    "version": "2.0.0",
    "description": "A Telegram bot that warns users when messages contain crying stickers or emojis",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "build:serverless": "tsc -p tsconfig.serverless.json",
        "test": "tsx --test tests/message-inspector.test.ts",
        "start": "node dist/index.js",
        "dev": "tsx watch index.ts",
        "deploy": "npm run build:serverless && tgcloud push"
    },
    "engines": {
        "node": ">=18"
    },
    "author": {
        "name": "agoudbg",
        "email": "agoudbg@gmail.com",
        "url": "https://github.com/agoudbg"
    },
    "dependencies": {
        "dotenv": "^16.4.5",
        "grammy": "^1.38.4"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
